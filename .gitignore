# --- vcpkg (manifest mode local install, not the vcpkg tool itself) ---
vcpkg_installed/

# --- .NET / WPF ---
*.dll
*.exe
!icons/**
project.lock.json
project.fragment.lock.json
artifacts/

# --- Project-specific: third-party code we deliberately don't vendor ---
# GPL-3.0 mods fetched at build time (scripts/fetch-third-party-mods.ps1 and scripts/fetch-windhawk-headers.ps1)
src/mods/taskbar-grouping/taskbar-grouping.wh.cpp
src/wrapper/include/*

# Local app runtime data if ever generated during dev/testing
**/app-settings.json
**/engine.log

# Keep redist files
!redist/*
*.aps
