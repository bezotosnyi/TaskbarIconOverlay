<Project>
  <PropertyGroup>
    <!-- Centralized clean locations -->
    <OutDir>$(SolutionDir)artifacts\bin\$(Configuration)\</OutDir>
    <OutputPath>$(SolutionDir)artifacts\bin\$(Configuration)\</OutputPath>
    <IntDir>$(SolutionDir)artifacts\obj\$(MSBuildProjectName)\$(Configuration)\</IntDir>

    <!-- Disables the automatic framework/runtime folder suffixes for WPF -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
</Project>
