<mah:MetroWindow
    x:Class="TaskbarIconOverlay.App.Views.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:TaskbarIconOverlay.App.Localization"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuAbout]}"
    Width="420"
    Height="315"
    Icon="pack://application:,,,/TaskbarIconOverlay.App;component/Assets/AppIcon.ico"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Image
                Width="56"
                Height="56"
                Source="pack://application:,,,/TaskbarIconOverlay.App;component/Assets/AppIcon.ico" />
            <StackPanel Margin="16,2,0,0">
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="TaskbarIconOverlay" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="Gray"
                    Text="{Binding VersionText}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AboutDescription]}" TextWrapping="Wrap" />
            <TextBlock Margin="0,12,0,0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AboutLicense]}" />
            <TextBlock Margin="0,12,0,0">
                <Hyperlink NavigateUri="https://github.com/bezotosnyi/TaskbarIconOverlay" RequestNavigate="RepositoryLink_RequestNavigate">
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AboutRepository]}" />
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <Button
            Grid.Row="2"
            Width="86"
            HorizontalAlignment="Right"
            Click="CloseButton_Click"
            Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Close]}" />
    </Grid>
</mah:MetroWindow>
