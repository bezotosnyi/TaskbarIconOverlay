<Window x:Class="TaskbarIconOverlay.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:vm="clr-namespace:TaskbarIconOverlay.App.ViewModels"
        xmlns:models="clr-namespace:TaskbarIconOverlay.App.Models"
        xmlns:loc="clr-namespace:TaskbarIconOverlay.App.Localization"
        Title="TaskbarIconOverlay" Height="640" Width="520"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <Style x:Key="SlotBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#33000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- ON/OFF -->
        <Button DockPanel.Dock="Bottom" Height="36" Margin="0,12,0,0"
                Command="{Binding ToggleEnabledCommand}">
            <TextBlock>
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                <Setter Property="Text" Value="{loc:LocalizationExtensions ToggleDisable}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Text" Value="{loc:LocalizationExtensions ToggleEnable}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Button>

        <TabControl>
            <!-- ================= Slots tab ================= -->
            <TabItem Header="{loc:LocalizationExtensions TabSlots}">
                <DockPanel Margin="8">
                    <Button DockPanel.Dock="Top" Content="{loc:LocalizationExtensions AddSlot}" Margin="0,0,0,8"
                            HorizontalAlignment="Left" Command="{Binding AddSlotCommand}"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Slots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:IconSlotViewModel}">
                                    <Border Style="{StaticResource SlotBorderStyle}" Width="110"
                                            MouseDown="SlotBorder_MouseDown"
                                            MouseMove="SlotBorder_MouseMove"
                                            Drop="SlotBorder_Drop"
                                            AllowDrop="True">
                                        <StackPanel>
                                            <Grid Height="64">
                                                <Border Background="#11000000" CornerRadius="4"/>
                                                <Image Source="{Binding Preview}" Stretch="Uniform" Margin="4"/>
                                                <TextBlock Text="{Binding SlotNumber}"
                                                           Visibility="{Binding HasNumber, Converter={StaticResource BoolToVis}}"
                                                           FontWeight="Bold"
                                                           FontSize="{Binding DataContext.NumberSize,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           Foreground="{Binding DataContext.NumberColor,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                                      Converter={StaticResource ColorToBrush}}"
                                                           Background="{Binding DataContext.BackgroundColor,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                                      Converter={StaticResource ColorToBrush}}"
                                                           Padding="3,0"
                                                           HorizontalAlignment="{Binding DataContext.NumberPosition,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                                      Converter={StaticResource PosToH}}"
                                                           VerticalAlignment="{Binding DataContext.NumberPosition,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                                      Converter={StaticResource PosToV}}"/>
                                            </Grid>
                                            <Button Content="{loc:LocalizationExtensions BrowseIcon}" Margin="0,4,0,0"
                                                    Command="{Binding DataContext.BrowseIconCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="{loc:LocalizationExtensions RemoveSlot}" Margin="0,2,0,0"
                                                    Command="{Binding DataContext.RemoveSlotCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ================= Numbering tab ================= -->
            <TabItem Header="{loc:LocalizationExtensions TabNumbering}">
                <StackPanel Margin="12">
                    <TextBlock Text="Кількість пронумерованих вікон" Margin="0,0,0,4"/>
                    <Slider Minimum="0" Maximum="{Binding AllowNumbersBeyondTen, Converter={StaticResource BoolToMaxNumbered}}"
                            Value="{Binding NumberedCount}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding NumberedCount}" HorizontalAlignment="Right" Margin="0,0,0,12"/>

                    <CheckBox Content="Дозволити нумерацію понад 10 (без Win+N)"
                              IsChecked="{Binding AllowNumbersBeyondTen}" Margin="0,0,0,12"/>

                    <CheckBox Content="Закріплювати іконку за вікном (не за позицією)"
                              IsChecked="{Binding StickyIconBinding}" Margin="0,0,0,12"/>

                    <TextBlock Text="Позиція номера" Margin="0,0,0,4"/>
                    <ComboBox SelectedItem="{Binding NumberPosition}" Margin="0,0,0,12">
                        <models:NumberPosition>TopLeft</models:NumberPosition>
                        <models:NumberPosition>TopRight</models:NumberPosition>
                        <models:NumberPosition>BottomLeft</models:NumberPosition>
                        <models:NumberPosition>BottomRight</models:NumberPosition>
                    </ComboBox>

                    <TextBlock Text="Розмір шрифту (8-16)" Margin="0,0,0,4"/>
                    <Slider Minimum="8" Maximum="16" Value="{Binding NumberSize}"
                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,12"/>

                    <CheckBox Content="Показувати номери на всіх таскбарах"
                              IsChecked="{Binding ShowOnAllTaskbars}"/>
                </StackPanel>
            </TabItem>

            <!-- ================= Appearance tab ================= -->
            <TabItem Header="{loc:LocalizationExtensions TabColors}">
                <StackPanel Margin="12">
                    <TextBlock Text="Колір цифр" Margin="0,0,0,4"/>
                    <Rectangle Height="24" Fill="{Binding NumberColor, Converter={StaticResource ColorToBrush}}"
                               Stroke="Gray" MouseDown="NumberColorSwatch_MouseDown" Margin="0,0,0,12"/>

                    <TextBlock Text="Колір обводки/фону" Margin="0,0,0,4"/>
                    <Rectangle Height="24" Fill="{Binding BackgroundColor, Converter={StaticResource ColorToBrush}}"
                               Stroke="Gray" MouseDown="BackgroundColorSwatch_MouseDown"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
